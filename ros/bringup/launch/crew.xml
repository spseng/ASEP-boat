<launch>
  <node pkg="mcu_bridge" exec="mcu_bridge" name="mcu_bridge" output="screen">
    <param from="$(find-pkg-share bringup)/config/boat.yaml"/>
    <param name="my_id" value="$(env BOAT_ID)"/>
  </node>

  <node pkg="mode_manager" exec="mode_manager" name="mode_manager" output="screen">
    <param name="my_id" value="$(env BOAT_ID)"/>
  </node>

  <node pkg="engineer" exec="engineer" name="engineer" output="screen"/>

  <!-- state/odom (ekf + navsat_transform) -->
  <include file="$(find-pkg-share navigator)/launch/navigator.launch.xml"/>

  <node pkg="scalar_source" exec="scalar_source" name="scalar_source" output="screen">
    <param from="$(find-pkg-share bringup)/config/cites/concord_nh.yaml"/>
  </node>

  <node pkg="lookout" exec="lookout" name="lookout" output="screen">
    <param from="$(find-pkg-share bringup)/config/cites/concord_nh.yaml"/>
  </node>

  <node pkg="helmsman" exec="helmsman" name="helmsman" output="screen"/>
</launch>